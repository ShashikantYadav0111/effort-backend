PORT=4000
# MongoDB Atlas (or any MongoDB) connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/effort?retryWrites=true&w=majority
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=90d
# "*" or comma-separated origins (mobile apps don't need CORS)
CORS_ORIGIN=*
# Set to false after you've created your account to lock the server down
ALLOW_REGISTRATION=true
